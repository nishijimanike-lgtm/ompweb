{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ompweb-desktop",
  "version": "0.1.0",
  "identifier": "com.kahme247.ompweb.desktop",
  "build": {
    "frontendDist": "./desktop-assets",
    "devUrl": "http://127.0.0.1:30178"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "omp-web Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
